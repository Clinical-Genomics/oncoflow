nextflow_process {

    name "Test Process CREATE_PARAMS_FILE"
    script "../main.nf"
    process "CREATE_PARAMS_FILE"

    tag "modules"
    tag "create_params_file"

    test("With test params list") {

        when {
            process {
                """
                input[0] = [
                    "param1: value1",
                    "param2: value2",
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("With test params list -stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    "param1: value1",
                    "param2: value2",
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
